    border-color: #14b8a6;
    background: #f0fdfa;
  }

  .box.note {
    border-color: #3b82f6;
    background: #eff6ff;
  }

  .box.warning {
    border-color: #f59e0b;
    background: #fffbeb;
  }

  .box.error {
    border-color: #ef4444;
    background: #fef2f2;
  }

