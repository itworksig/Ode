.docname {Quarkdown 完整功能写作手册}
.docdescription {一份面向初学者的 Quarkdown 长文模板，演示封面、页码、目录、图片、表格、公式、代码、布局和函数。}
.docauthor {itworksig}
.dockeywords
    - quarkdown
    - markdown
    - pdf
    - typesetting
.doctype {paged}
.doclang {zh}
.theme {paperwhite} layout:{latex}

.font {PingFang SC}
.font {PT Serif}
.font {Times New Roman} heading:{Times New Roman} size:{11pt}

.css
  :lang(zh), .font-zh {
    font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  }

  :lang(ru), .font-ru {
    font-family: "PT Serif", "Times New Roman", "Georgia", serif;
  }

  code, pre, .font-mono {
    font-family: "SFMono-Regular", "JetBrains Mono", "Menlo", "Consolas", monospace;
  }

  figure:has(pre),
  pre {
    border: 1px solid #d0d7de;
    border-radius: 9px;
    background: #f6f8fa;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.10);
    overflow: hidden;
  }

  pre {
    padding: 16px 18px;
    line-height: 1.58;
    font-size: 0.88em;
    tab-size: 2;
  }

  pre code,
  pre code.hljs {
    background: transparent;
    color: #24292f;
  }

  figure:has(pre) figcaption {
    background: #f6f8fa;
    border-top: 1px solid #d0d7de;
    color: #57606a;
    font-size: 0.85em;
    padding: 8px 14px;
  }

  .hljs {
    color: #24292f;
    background: transparent;
  }

  .hljs-comment,
  .hljs-quote {
    color: #6e7781;
    font-style: italic;
  }

  .hljs-keyword,
  .hljs-selector-tag,
  .hljs-subst {
    color: #cf222e;
    font-weight: 650;
  }

  .hljs-title,
  .hljs-title.function_,
  .hljs-function .hljs-title {
    color: #8250df;
    font-weight: 650;
  }

  .hljs-string,
  .hljs-attr,
  .hljs-symbol,
  .hljs-bullet,
  .hljs-addition {
    color: #116329;
  }

  .hljs-number,
  .hljs-literal,
  .hljs-variable,
  .hljs-template-variable {
    color: #953800;
  }

  .hljs-type,
  .hljs-class .hljs-title {
    color: #0550ae;
    font-weight: 650;
  }

  .hljs-built_in,
  .hljs-builtin-name,
  .hljs-meta,
  .hljs-section {
    color: #0969da;
  }

  .hljs-deletion {
    color: #82071e;
    background: #ffebe9;
  }

  .hljs-emphasis {
    font-style: italic;
  }

  .hljs-strong {
    font-weight: 700;
  }

  .hljs-ln-numbers {
    color: #8c959f;
    border-right: 1px solid #d8dee4;
    padding-right: 12px;
    text-align: right;
    user-select: none;
  }

  .hljs-ln-code {
    padding-left: 12px;
  }

  .hljs-copy-button {
    border: 1px solid #d0d7de;
    border-radius: 6px;
    background: #ffffff;
    color: #57606a;
    font-size: 0.78em;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    font-size: 0.95em;
  }

  table th,
  table td {
    border: 1px solid #cbd5e1;
    padding: 8px 10px;
    vertical-align: top;
  }

  table th {
    background: #eff6ff;
    color: #0f172a;
    font-weight: 700;
  }

  table tbody tr:nth-child(even) {
    background: #f8fafc;
  }

  table caption {
    color: #475569;
    font-size: 0.9em;
    margin-top: 6px;
  }

  .box {
    border: 1px solid #cbd5e1;
    border-left-width: 6px;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
  }

  .box header {
    border-bottom: 1px solid rgba(148, 163, 184, 0.35);
  }

